<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sandbox.Test.Integration</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(SboxEngineRoot)/bin/managed/*.dll" />
    <Reference Include="package.local.titanfall2">
      <HintPath>$(Titanfall2AssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SboxEngineRoot)/bin/managed/Sandbox.Engine.dll')" Text="Set SboxEngineRoot to an official engine runtime." />
    <Error Condition="!Exists('$(Titanfall2AssemblyPath)')" Text="Set Titanfall2PackageRoot to the built package." />
  </Target>
</Project>
